Screen {
    layers: base overlay;
}

#statusbar {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#views {
    height: 1fr;
    min-height: 6;
}

#log {
    height: 8;
    border-top: solid $primary-darken-2;
    padding: 0 1;
}

/* --- modals --- */

ConfirmScreen, LaunchScreen {
    align: center middle;
}

#confirm-box, #launch-box {
    width: 60;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

#confirm-question, #launch-title {
    width: 100%;
    padding-bottom: 1;
}

#confirm-buttons, #launch-buttons {
    height: auto;
    align-horizontal: right;
    padding-top: 1;
}

#confirm-buttons Button, #launch-buttons Button {
    margin-left: 2;
}

#launch-box Input {
    margin-bottom: 1;
}
